{
  "swagger": "2.0",
  "info": {
    "title": "Sample Pet Store (Swagger 2.0)",
    "version": "1.0.0",
    "description": "A minimal Swagger/OpenAPI 2.0 spec, used to prove 2.0 specs are auto-converted and supported."
  },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          {
            "name": "X-Client-Id",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 3
          }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "category"],
              "properties": {
                "name": { "type": "string", "minLength": 2, "maxLength": 40 },
                "category": { "type": "string", "enum": ["dog", "cat", "bird"] },
                "age": { "type": "integer", "minimum": 0, "maximum": 30 }
              }
            }
          }
        ],
        "responses": { "201": { "description": "Created" } }
      }
    }
  }
}
